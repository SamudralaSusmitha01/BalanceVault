# =========================================================================
# BalanceVault Environment Configuration
# =========================================================================

# Server Port
PORT=5000
NODE_ENV=production

# JWT Authentication Secret
JWT_SECRET=balancevault-super-secure-production-jwt-key-2026
JWT_EXPIRES_IN=24h

# First-Administrator One-Time Bootstrap Secret Token
BOOTSTRAP_SECRET=BalanceVaultAdminBootstrap2026!

# Database Configuration (PostgreSQL / Neon / Supabase)
# Leave blank for zero-config embedded storage during local testing
DATABASE_URL=postgresql://neondb_owner:npg_password@ep-balancevault-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Redis Rate Limiting (Optional - falls back seamlessly to in-memory sliding window)
REDIS_URL=redis://127.0.0.1:6379

# Rate Limiter Thresholds
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# CORS Allowed Origin (* or specific frontend domain)
CORS_ORIGIN=*
